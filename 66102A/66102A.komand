      "subsystem": "Common"
    },
    "Reset_Module": {
      "scpi": "*RST",
      "description": "Reset Module",
      "group": "Output Control",
      "notes": "Undefined on a module addressed at its own GPIB secondary address, which is how all seven on this bench are wired — `SYST:ERR?` answers -113 after it, and it silently kills any reply chained behind it. Correct only for a mainframe addressed as one instrument. Checked 2026-08-08. Was `INST:NSEL <chan>;*RST`: the 661xxA has no INSTrument subsystem (the HP 661xxA MPS Programming Guide 5959-3362 has none) — each module is its own GPIB secondary address (Dev730-N), and the bench answered -113 after `INST:NSEL`, which also killed every reply chained behind it. The module's own commands, each from the root (p. 41, 48, 35, 33).",
      "unverified": true,
      "alias_of": "Reset_Device"
    },
