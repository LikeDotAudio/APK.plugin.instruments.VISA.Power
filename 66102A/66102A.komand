    },
    "module_settings": {
      "scpi": "VOLT?;:CURR?;:OUTP?;:MEAS:VOLT?;:MEAS:CURR?;:STAT:OPER:COND?",
      "description": "Everything the module was told and everything it reports, in one round trip.",
      "group": "Readback Queries",
      "subsystem": "MEASure",
      "returns": {
        "count": 6,
        "separator": ";",
        "fields": [
          {
            "name": "set_voltage",
            "type": "NR3",
            "unit": "V"
          },
          {
