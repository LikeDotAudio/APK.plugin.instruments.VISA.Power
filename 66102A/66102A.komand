    "Set_Output": {
      "scpi": "OUTP <state>",
      "description": "Output on or off.",
      "arg": {
        "kind": "bool",
        "values": [
          "OFF",
          "ON"
        ]
      },
      "args": [
        "state"
      ],
      "group": "Output Control",
      "subsystem": "OUTPut",
      "notes": "`OUTP?` answers 1 or 0, so the panel's toggle is keyed 1/0 and sends what it reads back. Verified on the 66101A at gpib7,30,0, 2026-08-08."
    },
    "Set_Output_OFF": {
