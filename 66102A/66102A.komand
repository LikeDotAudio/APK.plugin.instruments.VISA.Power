    "Set_Output_Dfi_Link": {
      "scpi": "OUTP:DFI:LINK \"<value>\"",
      "description": "This command specifies which events within the power module are linked to DFI source events",
      "arg": {
        "kind": "enum",
        "values": [
          "OFF",
          "CC",
          "CV",
          "ESB",
          "OPC",
          "OPER",
          "QUES",
          "MAV",
          "RQS",
          "SUM3"
        ],
        "default": "SUM3"
      },
      "args": [
        "value"
      ],
      "subsystem": "OUTP",
      "unverified": true,
      "notes": "String data, sent quoted: `OUTP:DFI:LINK OFF` is -148 \"Character data not allowed\", `\"OFF\"` is taken (HP 66lxxA MPS Programming Guide 5959-3362 (https://xdevs.com/doc/HP_Agilent_Keysight/661xxA_programming.pdf) p. 40, Table 3-1; the 66102A at gpib7,30,1 (Dev730-1), 2026-11-06)."
    },
