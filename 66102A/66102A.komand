    "Set_Current": {
      "scpi": "CURR <value>",
      "description": "Current limit.",
      "arg": {
        "kind": "numeric",
        "unit": "A"
      },
      "args": [
        "value"
      ],
      "group": "Configuration",
      "subsystem": "SOURce",
      "notes": "The module holds this limit and drops into CC when it is reached, which is what `module_settings/oper_condition` bit 10 reports. Verified on the 66101A at gpib7,30,0, 2026-08-08."
    },
